{
  "name": "lustro",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:dev": "node scripts/setup.mjs dev",
    "build:setup": "node scripts/setup.mjs build",
    "icons": "tauri icon src/assets/logo.svg -o src-tauri/icons && node -e \"for (const d of ['android','ios']) require('fs').rmSync('src-tauri/icons/'+d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "i18next": "^26.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "description": "Storage manager for Windows 11",
  "license": "MIT"
}
